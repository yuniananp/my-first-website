<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>我的第一个网站</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f7fa;
            color: #222;
            text-align: center;
        }

        .container {
            max-width: 800px;
            margin: 80px auto;
            padding: 40px 20px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        h1 {
            font-size: 42px;
            margin-bottom: 15px;
            color: #ff6b6b;
        }

        p {
            font-size: 20px;
            color: #666;
        }

        button {
            margin-top: 25px;
            padding: 14px 30px;
            border: none;
            border-radius: 30px;
            background: #1677ff;
            color: white;
            font-size: 18px;
            cursor: pointer;
        }

        button:hover {
            background: #0e5ed7;
        }

        .result {
            margin-top: 30px;
            font-size: 42px;
            font-weight: bold;
            display: none;
        }

        .result span {
            display: inline-block;
            margin: 0 3px;
            animation: jump 0.5s ease;
        }

        @keyframes jump {
            0% {
                transform: translateY(20px);
                opacity: 0;
            }

            100% {
                transform: translateY(0);
                opacity: 1;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>你好，王康！</h1>

        <p>这是我的第一个网站</p>

        <button onclick="showMessage()">
            点击我
        </button>

        <div class="result" id="message"></div>

    </div>

    <script>
        function showMessage() {

            const colors = [
                "#ff0000",
                "#ff7a00",
                "#ffd000",
                "#00b83d",
                "#00aaff",
                "#6633ff",
                "#ff00aa"
            ];

            const text = "王币牛康";

            let result = "";

            for (let i = 0; i < text.length; i++) {

                result += `
                    <span style="color:${colors[i % colors.length]}">
                        ${text[i]}
                    </span>
                `;
            }

            const message = document.getElementById("message");

            message.innerHTML = result;

            message.style.display = "block";
        }
    </script>

</body>
</html>